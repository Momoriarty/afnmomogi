<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/ivOnboarding"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:background="@drawable/circle_placeholder"
        android:backgroundTint="#FFEBEE"
        android:padding="26dp"
        android:src="@android:drawable/ic_menu_compass"
        app:tint="#C62828" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Judul Onboarding"
        android:textAlignment="center"
        android:textColor="#17181B"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="4dp"
        android:text="Deskripsi fitur aplikasi futsal."
        android:textAlignment="center"
        android:textColor="#72767F"
        android:textSize="14sp" />

</LinearLayout>