<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/rounded_border"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- Nomor Posisi -->
        <TextView
            android:id="@+id/tvPosisi"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:text="1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#C62828"
            android:gravity="center"
            android:background="@drawable/status_chip_bg"/>

        <!-- Nama Tim -->
        <TextView
            android:id="@+id/tvNamaTim"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Garuda Melayu FC"
            android:textColor="#17181B"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginStart="12dp"/>

        <!-- Main (M) -->
        <TextView
            android:id="@+id/tvMain"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="5 M"
            android:textColor="#72767F"
            android:textSize="11sp"
            android:gravity="center"/>

        <!-- Selisih Gol (SG) -->
        <TextView
            android:id="@+id/tvSG"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="+8"
            android:textColor="#72767F"
            android:textSize="11sp"
            android:gravity="center"/>

        <!-- Poin -->
        <TextView
            android:id="@+id/tvPoin"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="13"
            android:textColor="#16865A"
            android:textStyle="bold"
            android:textSize="13sp"
            android:gravity="end"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>