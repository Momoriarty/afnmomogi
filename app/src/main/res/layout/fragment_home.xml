<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Header Melengkung dengan Background Drawable -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_gms"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="28dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnProfile"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/circle_placeholder"
                        android:backgroundTint="#FFFFFF"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="#C62828" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Halo, Arifin!"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Garuda Melayu Futsal"
                            android:textColor="#FFCDD2"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/circle_placeholder"
                        android:backgroundTint="#80000000"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_popup_reminder"
                        app:tint="#FFFFFF" />
                </LinearLayout>

                <!-- Upcoming Match Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#8E1B1B"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/circle_placeholder"
                            android:backgroundTint="#F4B400"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="PERTANDINGAN TERDEKAT"
                            android:textColor="#17181B"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Liga Futsal Melayu Cup 2026"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Rabu, 1 Okt - 16.00 WIB | Riau Sport Center"
                            android:textColor="#FFCDD2"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnOpenWeb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="#F4B400"
                            android:text="Lihat Live Score"
                            android:textColor="#17181B"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- 2. Konten Tengah -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp">

                <!-- Label Akses Cepat Grid -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Akses Cepat (Menu Grid)"
                    android:textColor="#17181B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- 2. GridLayout (4 Tombol dalam 2 Kolom) -->
                <androidx.gridlayout.widget.GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:columnCount="2"
                    app:useDefaultMargins="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGridTanding"
                        android:text="Cari Match"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#C62828"
                        app:cornerRadius="12dp"
                        app:icon="@android:drawable/ic_menu_search"
                        app:layout_columnWeight="1"
                        app:layout_gravity="fill_horizontal" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGridJadwal"
                        android:text="Jadwal Liga"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#C62828"
                        app:cornerRadius="12dp"
                        app:icon="@android:drawable/ic_menu_today"
                        app:layout_columnWeight="1"
                        app:layout_gravity="fill_horizontal" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGridTim"
                        android:text="Daftar Tim"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#C62828"
                        app:cornerRadius="12dp"
                        app:icon="@android:drawable/ic_menu_myplaces"
                        app:layout_columnWeight="1"
                        app:layout_gravity="fill_horizontal" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGridAturan"
                        android:text="Aturan Match"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#C62828"
                        app:cornerRadius="12dp"
                        app:icon="@android:drawable/ic_menu_info_details"
                        app:layout_columnWeight="1"
                        app:layout_gravity="fill_horizontal" />
                </androidx.gridlayout.widget.GridLayout>

                <!-- 3. ListView: Pengumuman Turnamen (SimpleAdapter) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Pengumuman Turnamen (ListView)"
                    android:textColor="#17181B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ListView
                    android:id="@+id/lvPengumuman"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="8dp"
                    android:background="#F9F9FB"
                    android:divider="#E0E0E0"
                    android:dividerHeight="1dp" />

                <!-- 4. RecyclerView: Klasemen Sementara -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Klasemen Sementara (RecyclerView)"
                    android:textColor="#17181B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp"
                    android:text="Update klasemen grup pekan ke-5"
                    android:textColor="#72767F"
                    android:textSize="11sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvKlasemen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="24dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>