<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8"
    tools:context=".ProfileFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- Judul Halaman -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROFIL DEVELOPER"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#17181B"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp" />

            <!-- Kartu Biodata Putih -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBiodata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NAMA DEVELOPER"
                        android:textSize="11sp"
                        android:textColor="#72767F"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Arifin"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#17181B"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROGRAM STUDI &amp; KAMPUS"
                        android:textSize="11sp"
                        android:textColor="#72767F"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Teknik Informatika - Politeknik Caltex Riau"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#17181B"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MEDIA SOSIAL"
                        android:textSize="11sp"
                        android:textColor="#72767F"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@arifin / github.com/arifin"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#17181B"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOBI"
                        android:textSize="11sp"
                        android:textColor="#72767F"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Futsal &amp; Eksplorasi Mobile App"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#17181B"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KEKUATAN TERBESAR"
                        android:textSize="11sp"
                        android:textColor="#72767F"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Problem Solver &amp; Cepat Belajar Hal Baru"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#C62828" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tombol Logout Merah -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="32dp"
                android:text="Logout"
                android:backgroundTint="#C62828" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>